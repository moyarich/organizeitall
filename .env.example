# Copy to .env. Use KEY="value" entries compatible with direnv and Bash.
# Never commit .env or your downloaded .p8 private key.
APPLE_TEAM_ID=""
# App Store Connect team API key with access to this app and signing resources.
ASC_KEY_ID=""
ASC_ISSUER_ID=""
# Absolute path, or path relative to this repository. Do not paste key contents.
ASC_KEY_PATH=""
APP_VERSION="1.0.0"
# Set higher than the last build uploaded for this version.
BUILD_NUMBER="1"
# Full Xcode used by direnv and publishing:
DEVELOPER_DIR="/Applications/Xcode.app/Contents/Developer"
